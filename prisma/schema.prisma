datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Place {
  id         String   @id @default(uuid())
  title      String
  country    String
  category   String   // e.g., "Beach", "Mountains", "Historic", "City", "Hidden Gem", "Road Trip"
  targetYear Int?
  budget     Float?
  status     String   @default("WISHLIST") // "WISHLIST" | "PLANNING" | "VISITED"
  isFavorite Boolean  @default(false)
  imageUrl   String   // Stores image URL (e.g. Vercel Blob URL or remote image)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("places")
}

